{
  "repo": ".",
  "baseBranch": "main",
  "worktreeDir": "../orch-worktrees",
  "dbPath": ".orch/orch.db",
  "host": "0.0.0.0",
  "port": 4800,
  "publicUrl": "http://YOUR-SERVER:4800",
  "agents": {
    "timeoutMinutes": 90,
    "adapters": {
      "claude": {
        "type": "claude",
        "command": "claude",
        "extraArgs": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "env": {}
      },
      "gemini": {
        "type": "gemini",
        "command": "gemini",
        "extraArgs": [
          "--yolo",
          "--skip-trust"
        ],
        "env": {}
      }
    },
    "roles": {
      "planner": {
        "adapter": "claude",
        "model": ""
      },
      "worker": {
        "adapter": "claude",
        "model": ""
      },
      "validator": {
        "adapter": "gemini",
        "model": "pro"
      }
    }
  },
  "scheduler": {
    "maxParallel": 1,
    "tickSeconds": 5,
    "maxAttempts": 2,
    "resumeOnRetry": true
  },
  "validation": {
    "command": "npm test",
    "agent": true
  },
  "git": {
    "pr": true,
    "mergePolicy": "auto",
    "squash": true,
    "copyFiles": [],
    "setupCommand": "",
    "tickTasksMd": true
  },
  "handoff": {
    "specChars": 12000,
    "historyChars": 6000,
    "contextFiles": [
      "plan.md",
      "spec.md"
    ]
  },
  "notify": {
    "ntfyUrl": "https://ntfy.sh/CHANGE-ME",
    "ntfyToken": ""
  }
}
