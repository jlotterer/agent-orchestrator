{
  "name": "myapp",
  "baseBranch": "main",
  "scheduler": {
    "maxParallel": 1,
    "maxAttempts": 2,
    "resumeOnRetry": true
  },
  "validation": {
    "command": "npm test",
    "agent": true,
    "phase": {
      "enabled": true,
      "command": "",
      "maxFixups": 2
    },
    "ui": {
      "startCommand": "",
      "url": "http://127.0.0.1:{port}/",
      "readyTimeoutSeconds": 120,
      "env": {}
    }
  },
  "git": {
    "pr": true,
    "mergePolicy": "auto",
    "squash": true,
    "copyFiles": [],
    "setupCommand": "",
    "tickTasksMd": true,
    "feedback": {
      "enabled": true,
      "waitForChecks": true,
      "pollSeconds": 60,
      "maxRounds": 3,
      "checksTimeoutMinutes": 60,
      "noChecksGraceSeconds": 90,
      "trigger": "/orch",
      "ignoreAuthors": [],
      "logChars": 6000
    }
  },
  "handoff": {
    "specChars": 12000,
    "historyChars": 6000,
    "contextFiles": [
      "spec.md",
      "data-model.md",
      "plan.md"
    ],
    "briefChars": 8000,
    "reqChars": 4000,
    "contractChars": 6000,
    "rulesChars": 6000,
    "requirementsFile": "docs/requirements.md",
    "projectFiles": [
      "AGENTS.md"
    ]
  },
  "roles": {
    "planner": {
      "adapter": "claude",
      "model": ""
    },
    "worker": {
      "adapter": "claude",
      "model": ""
    },
    "validator": {
      "adapter": "gemini",
      "model": "pro"
    }
  }
}
